nx-cache/
# =========================
# Cloud / Terraform
# =========================
exec -l /
.terraform/
*.tfstate
*.tfstate.*
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Never commit secret-bearing var files (local-only)
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
terraform.tfvars.json
**/terraform.tfvars
**/terraform.tfvars.json
# Non-secret env config and examples are allowed
!**/dev.tfvars
!**/terraform.tfvars.example
# Keep provider lockfile in version control
!.terraform.lock.hcl
# =========================
# Misc
# =========================
*.swp
*.swo
*.rdb
implementation_plan.md
.history/