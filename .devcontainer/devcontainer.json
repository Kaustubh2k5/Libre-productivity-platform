// For format details, see https://aka.ms. For config options, see the
// README at: https://github.com
{
	"name": "Node.js & TypeScript",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-22-bookworm",
	"features": {
		"ghcr.io/dhoeric/features/google-cloud-cli:1": {
		"version": "latest"
		},
		"ghcr.io/devcontainers/features/terraform:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers-extra/features/pnpm:2": {
			"version": "latest"
		},
		"ghcr.io/helpers4/devcontainer/vite-plus:1": {
			"installVitePlus": true,
			"installGlobally": true
		}
	},

	"postCreateCommand": "npm install -g pnpm && pnpm install",

	"customizations": {
		"vscode": {
			"extensions": [
				"hashicorp.terraform",
				"googlecloudtools.cloudcode",
				"ms-azuretools.vscode-docker",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint"
			]
		}
	},
	"runArgs": [
		"--dns=8.8.8.8",
		"--dns=1.1.1.1"
	]
}
