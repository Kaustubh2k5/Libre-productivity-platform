generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Goal {
  id String @id @default(uuid())

  uid String

  name        String
  description String?

  columns Json

  isActive Boolean @default(true)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableSlots TimetableSlot[]

  @@unique([uid, name])
  @@index([uid])
}

model Timetable {
  id String @id @default(uuid())

  uid      String
  date     DateTime
  timezone String

  version Int @default(1)

  isActive Boolean @default(true)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots TimetableSlot[]

  @@unique([uid, date])
  @@index([uid])
}

model TimetableSlot {
  id String @id @default(uuid())

  timetableId String
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id])

  title       String
  description String?

  startTime DateTime
  endTime   DateTime

  estimatedHours Float
  priority       TaskPriority

  position Int

  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timetableId])
  @@index([goalId])
}

model OutboxEvent {
  id String @id @default(uuid())

  topic     String
  eventType String

  payload Json

  status OutboxStatus @default(PENDING)

  retryCount Int     @default(0)
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
