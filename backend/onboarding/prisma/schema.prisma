// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserCore {
  uid        String   @id

  fullName   String
  dateOfBirth DateTime
  occupation String

  profileCompleted     Boolean @default(false)
  constraintsCompleted Boolean @default(false)

  behaviour UserBehaviourCore?

  constraints UserConstraint[]
}

model UserBehaviourCore {
  uid String @id

  focusDuration     String
  distractionLevel  String
  energyConsistency String
  taskInitiation    String
  recoveryPattern   String

  user UserCore @relation(
    fields: [uid],
    references: [uid],
    onDelete: Cascade
  )
}

model UserConstraint {
  cid String @id @default(uuid())

  uid String

  name String

  startTime String
  endTime String

  user UserCore @relation(
    fields: [uid],
    references: [uid],
    onDelete: Cascade
  )
}
