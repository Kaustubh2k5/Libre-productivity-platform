generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SandboxTable {
  id          String   @id @default(uuid())
  uid         String
  name        String
  description String?
  columns     Json     @default("[]")
  rows        Json     @default("[]")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uid])
}
